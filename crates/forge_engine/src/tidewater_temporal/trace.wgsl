struct TidewaterTemporalPacket {
    current_unjittered_clip_from_world: mat4x4<f32>,
    previous_unjittered_clip_from_world: mat4x4<f32>,
    current_world_from_jittered_clip: mat4x4<f32>,
    previous_world_from_jittered_clip: mat4x4<f32>,
    camera_position: vec4<f32>,
    previous_camera_position: vec4<f32>,
    sizes: vec4<u32>,
    near_far_jitter: vec4<f32>,
    phase_epoch_seed: vec4<u32>,
};
@group(1) @binding(0) var<uniform> tidewater_temporal_packet: TidewaterTemporalPacket;
// Extra previous_source_far is camera history metadata, not an artistic setting.
// All five source control values and the Packet336 ABI remain unchanged.
struct TAAUParams {
    frameWeight: f32,
    depthThreshold: f32,
    edgeDepthDiff: f32,
    maxVelocityLength: f32,
    hasWaterMask: f32,
    previous_source_far: f32,
    _padding0: f32,
    _padding1: f32,
};
@group(1) @binding(1) var<uniform> taau: TAAUParams;
@group(0) @binding(0) var taauBeauty: texture_2d<f32>;
@group(0) @binding(1) var taauDepth: texture_depth_2d;
@group(0) @binding(2) var taauPrevDepth: texture_depth_2d;
@group(0) @binding(3) var taauVelocity: texture_2d<f32>;
@group(0) @binding(4) var taauMask: texture_2d<f32>;
@group(0) @binding(5) var taauHistory: texture_2d<f32>;
@group(0) @binding(6) var smpLinearClamp: sampler;
fn sat( x: f32 ) -> f32 { return clamp( x, 0.0, 1.0 ); }
fn pow2( x: f32 ) -> f32 { return x * x; }
fn luminance( c: vec3f ) -> f32 { return dot( c, vec3f( 0.2126, 0.7152, 0.0722 ) ); }

struct FSIn { @builtin( position ) pos: vec4f, @location( 0 ) uv: vec2f };
@vertex fn vs( @builtin( vertex_index ) i: u32 ) -> FSIn {
	let p = vec2f( f32( ( i << 1u ) & 2u ), f32( i & 2u ) );
	var o: FSIn;
	o.pos = vec4f( p * 2.0 - 1.0, 0.000000, 1.0 );
	o.uv = vec2f( p.x, 1.0 - p.y );
	return o;
}
// Bevy reverse-infinite depth cannot be converted with 1-depth.
// Reconstruct with the actual jittered inverse, then compare in the source
// finite current-camera depth space. Perspective RH clip.w == -view.z.
// A cleared infinite ray is placed on the source camera's finite far plane.
fn taauWorldFromBevyDepth(inv: mat4x4f, unjittered: mat4x4f,
    camera: vec3f, sourceFar: f32, uv: vec2f, d: f32) -> vec3f {
    let p = inv * vec4f(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, d, 1.0);
// TRACE243_BEGIN actual-previous-homogeneous
    if (trace243_depth_slot == 50u) { trace243_write(52u, p); }
// TRACE243_END actual-previous-homogeneous
    if (p.w == 0.0) {
        let forwardDistance = (unjittered * vec4f(p.xyz, 0.0)).w;
        return camera + p.xyz * (sourceFar / forwardDistance);
    }
    return p.xyz / p.w;
}

fn taauSourceStandardDepth(world: vec3f) -> f32 {
    let viewZ = -(tidewater_temporal_packet.current_unjittered_clip_from_world * vec4f(world, 1.0)).w;
// TRACE243_BEGIN actual-world-viewz
    trace243_write(trace243_depth_slot, vec4f(world, viewZ));
// TRACE243_END actual-world-viewz
    let near = tidewater_temporal_packet.near_far_jitter.x;
    let far = tidewater_temporal_packet.near_far_jitter.y;
    return ((near + viewZ) * far) / ((far - near) * viewZ);
}

// Pixel-center reconstruction follows the actual clamped input-depth texel.
fn taauDepthAt(p: vec2i) -> f32 {
    let s = vec2i(textureDimensions(taauDepth));
    let texel = clamp(p, vec2i(0), s - 1);
    let uv = (vec2f(texel) + vec2f(0.5)) / vec2f(s);
    let d = textureLoad(taauDepth, texel, 0);
// TRACE243_BEGIN actual-raw-current-depth
    trace243_current_raw_depth = d;
// TRACE243_END actual-raw-current-depth
    let world = taauWorldFromBevyDepth(
        tidewater_temporal_packet.current_world_from_jittered_clip,
        tidewater_temporal_packet.current_unjittered_clip_from_world,
        tidewater_temporal_packet.camera_position.xyz,
        tidewater_temporal_packet.near_far_jitter.y, uv, d);
    return taauSourceStandardDepth(world);
}

// Preserve source unclamped history UV reconstruction and clamped depth fetch.
fn taauPreviousDepth(uv: vec2f) -> f32 {
    let s = vec2i(textureDimensions(taauPrevDepth));
    let d = textureLoad(taauPrevDepth, clamp(vec2i(uv * vec2f(s)), vec2i(0), s - 1), 0);
// TRACE243_BEGIN actual-raw-previous-depth
    trace243_write(51u, vec4f(uv, d, 0.0));
// TRACE243_END actual-raw-previous-depth
    let world = taauWorldFromBevyDepth(
        tidewater_temporal_packet.previous_world_from_jittered_clip,
        tidewater_temporal_packet.previous_unjittered_clip_from_world,
        tidewater_temporal_packet.previous_camera_position.xyz,
        taau.previous_source_far, uv, d);
    return taauSourceStandardDepth(world);
}

fn taauClipAABB( currentColor: vec4f, historyColor: vec4f, minColor: vec4f, maxColor: vec4f ) -> vec4f {
	let pClip = ( maxColor.rgb + minColor.rgb ) * 0.5;
	let eClip = ( maxColor.rgb - minColor.rgb ) * 0.5 + 1e-7;
	let vClip = historyColor - vec4f( pClip, currentColor.a );
	let vUnit = vClip.xyz / eClip;
	let absUnit = abs( vUnit );
	let maxUnit = max( absUnit.x, max( absUnit.y, absUnit.z ) );
// TRACE243_BEGIN actual-aabb-locals
	trace243_write(20u, vec4f(pClip, currentColor.a));
	trace243_write(21u, vec4f(eClip, maxUnit));
	trace243_write(22u, vClip);
	trace243_write(23u, vec4f(vUnit, f32(maxUnit > 1.0)));
// TRACE243_END actual-aabb-locals
	return select( historyColor, vec4f( pClip, currentColor.a ) + vClip / maxUnit, maxUnit > 1.0 );
}

fn taauFlickerReduction( currentColor: vec4f, historyColor: vec4f, currentWeight: f32 ) -> vec4f {
	let compressedCurrent = currentColor * ( 1.0 / ( max( currentColor.r, max( currentColor.g, currentColor.b ) ) + 1.0 ) );
	let compressedHistory = historyColor * ( 1.0 / ( max( historyColor.r, max( historyColor.g, historyColor.b ) ) + 1.0 ) );
	let luminanceCurrent = luminance( compressedCurrent.rgb );
	let luminanceHistory = luminance( compressedHistory.rgb );
	let weightCurrent = currentWeight / ( luminanceCurrent + 1.0 );
	let weightHistory = ( 1.0 - currentWeight ) / ( luminanceHistory + 1.0 );
// TRACE243_BEGIN actual-flicker-locals
	trace243_write(24u, compressedCurrent);
	trace243_write(25u, compressedHistory);
	trace243_write(26u, vec4f(luminanceCurrent, luminanceHistory, weightCurrent, weightHistory));
// TRACE243_END actual-flicker-locals
	return ( currentColor * weightCurrent + historyColor * weightHistory ) / max( weightCurrent + weightHistory, 0.00001 );
}

// Catmull-Rom history lookup with 5 bilinear taps (the 4 corner taps are dropped)
fn taauSampleHistory( uvIn: vec2f ) -> vec4f {
	let size = vec2f( textureDimensions( taauHistory ) );
	let samplePos = uvIn * size;
	let texPos1 = floor( samplePos - 0.5 ) + 0.5;
	let f = samplePos - texPos1;
	let w0 = f * ( f * ( f * -0.5 + 1.0 ) - 0.5 );
	let w1 = f * f * ( f * 1.5 - 2.5 ) + 1.0;
	let w2 = f * ( f * ( f * -1.5 + 2.0 ) + 0.5 );
	let w3 = f * f * ( f * 0.5 - 0.5 );
	let w12 = w1 + w2;
	let tp0 = ( texPos1 - 1.0 ) / size;
	let tp3 = ( texPos1 + 2.0 ) / size;
	let tp12 = ( texPos1 + w2 / w12 ) / size;
	let wa = w12.x * w0.y; let wb = w0.x * w12.y; let wc = w12.x * w12.y; let wd = w3.x * w12.y; let we = w12.x * w3.y;
// TRACE243_BEGIN history-coordinates
	trace243_write(53u, vec4f(tp0, tp3));
	trace243_write(54u, vec4f(tp12, w12));
	trace243_write(55u, vec4f(w0, w1));
	trace243_write(56u, vec4f(w2, w3));
	trace243_write(57u, vec4f(wa, wb, wc, wd));
	trace243_write(58u, vec4f(we, 0.0, 0.0, 0.0));
// TRACE243_END history-coordinates
	let sum = textureSampleLevel( taauHistory, smpLinearClamp, vec2f( tp12.x, tp0.y ), 0.0 ) * wa
		+ textureSampleLevel( taauHistory, smpLinearClamp, vec2f( tp0.x, tp12.y ), 0.0 ) * wb
		+ textureSampleLevel( taauHistory, smpLinearClamp, vec2f( tp12.x, tp12.y ), 0.0 ) * wc
		+ textureSampleLevel( taauHistory, smpLinearClamp, vec2f( tp3.x, tp12.y ), 0.0 ) * wd
		+ textureSampleLevel( taauHistory, smpLinearClamp, vec2f( tp12.x, tp3.y ), 0.0 ) * we;
// TRACE243_BEGIN actual-history-sum
	trace243_write(27u, sum);
	trace243_write(28u, vec4f(wa + wb + wc + wd + we, 0.0, 0.0, 0.0));
// TRACE243_END actual-history-sum
	return max( sum / ( wa + wb + wc + wd + we ), vec4f( 0.0 ) );
}

fn taauLoadBeauty( p: vec2i ) -> vec4f {
	let s = vec2i( textureDimensions( taauBeauty ) );
	return textureLoad( taauBeauty, clamp( p, vec2i( 0 ), s - 1 ), 0 );
}

// standard (0 near .. 1 far) perspective depth of the reversed-Z buffer at p (clamped)
// Source taauDepthAt replaced only by explicit depth seam below.

// last frame's depth at uv, reprojected into this frame's camera (standard perspective depth)
// Source taauPreviousDepth replaced only by explicit depth seam below.

fn fragment( in: FSIn ) -> vec4f {
// TRACE243_BEGIN begin
	trace243_begin(in);
// TRACE243_END begin
	let uvNode = in.uv;
	let inputSizeF = vec2f( textureDimensions( taauBeauty ) );

	// output pixel center in input-pixel coordinates; closest jittered input tap
	let pIn = uvNode * inputSizeF;
	let closestTapF = round( pIn - ( vec2f( 0.5 ) + tidewater_temporal_packet.near_far_jitter.zw ) );
	let closestTap = vec2i( closestTapF );
// TRACE243_BEGIN input-coordinates
	trace243_write(1u, vec4f(pIn, closestTapF));
// TRACE243_END input-coordinates

	// depth dilation around the closest input tap
	var closestDepth = 2.0;
	var closestPositionTexel = vec2i( 0 );
	var farthestDepth = -1.0;
	for ( var x = -1; x <= 1; x++ ) {
		for ( var y = -1; y <= 1; y++ ) {
			let neighbor = closestTap + vec2i( x, y );
// TRACE243_BEGIN depth-slot
			trace243_depth_slot = 41u + u32(x + 1) * 3u + u32(y + 1);
// TRACE243_END depth-slot
			let depth = taauDepthAt( neighbor );
// TRACE243_BEGIN nine-depths
			trace243_write(32u + u32(x + 1) * 3u + u32(y + 1),
				vec4f(vec2f(neighbor), depth, trace243_current_raw_depth));
// TRACE243_END nine-depths
			if ( depth < closestDepth ) {
				closestDepth = depth;
				closestPositionTexel = neighbor;
			}
			if ( depth > farthestDepth ) { farthestDepth = depth; }
		}
	}

	// reproject using the velocity at the dilated depth tap
	let vs = vec2i( textureDimensions( taauVelocity ) );
	let offsetUV = textureLoad( taauVelocity, clamp( closestPositionTexel, vec2i( 0 ), vs - 1 ), 0 ).xy;
	let historyUV = uvNode - offsetUV;
// TRACE243_BEGIN chosen-tap
	trace243_write(2u, vec4f(vec2f(closestTap), vec2f(closestPositionTexel)));
	trace243_write(4u, vec4f(historyUV, offsetUV));
	trace243_depth_slot = 50u;
// TRACE243_END chosen-tap
	let previousDepth = taauPreviousDepth( historyUV );
// TRACE243_BEGIN depth-extrema
	trace243_write(3u, vec4f(closestDepth, farthestDepth, previousDepth, 0.0));
	trace243_depth_slot = 64u;
// TRACE243_END depth-extrema

	// history validity
	let isValidUV = all( historyUV >= vec2f( 0.0 ) ) && all( historyUV <= vec2f( 1.0 ) );
	let isEdge = farthestDepth - closestDepth > taau.edgeDepthDiff;
	let isDisocclusion = closestDepth - previousDepth > taau.depthThreshold;
	// The water surface moves on its own (waves, the wake and bow wave travelling with a boat) while
	// its motion vectors only carry the camera's motion: near the camera its depth changes between
	// frames by more than the disocclusion threshold. Rejecting its history there shows the raw
	// jittered frame (flicker), so water always keeps its history and relies on the variance clip.
	let ms = vec2i( textureDimensions( taauMask ) );
	let isWater = taau.hasWaterMask > 0.5 && textureLoad( taauMask, clamp( closestTap, vec2i( 0 ), ms - 1 ), 0 ).g > 0.5;
	let hasValidHistory = isValidUV && ( isEdge || ! isDisocclusion || isWater );
// TRACE243_BEGIN validity
	trace243_write(5u, vec4f(f32(isValidUV), f32(isEdge), f32(isDisocclusion), f32(isWater)));
// TRACE243_END validity

	// 9-tap Blackman-Harris (Gaussian approximation) reconstruction of the current frame and
	// the moments for the variance clip
	var sumColor = vec4f( 0.0 );
	var sumWeight = 0.0;
	var moment1 = vec4f( 0.0 );
	var moment2 = vec4f( 0.0 );
	for ( var y = -1; y <= 1; y++ ) {
		for ( var x = -1; x <= 1; x++ ) {
			let tap = closestTap + vec2i( x, y );
			let delta = pIn - ( vec2f( tap ) + ( vec2f( 0.5 ) + tidewater_temporal_packet.near_far_jitter.zw ) );
			let w = exp( dot( delta, delta ) * -2.29 );
			let c = max( taauLoadBeauty( tap ), vec4f( 0.0 ) );
			sumColor += c * w;
			sumWeight += w;
			moment1 += c;
			moment2 += c * c;
		}
	}

	let currentColor = sumColor / max( sumWeight, 1e-5 );
// TRACE243_BEGIN reconstruction
	trace243_write(7u, sumColor);
	trace243_write(9u, moment1);
	trace243_write(10u, moment2);
	trace243_write(15u, currentColor);
// TRACE243_END reconstruction

	let mean = moment1 / 9.0;
	let motionFactor = sat( length( ( uvNode - historyUV ) * inputSizeF ) / taau.maxVelocityLength );
	let varianceGamma = mix( 0.5, 1.0, pow2( 1.0 - motionFactor ) );
	let variance = sqrt( max( moment2 / 9.0 - mean * mean, vec4f( 0.0 ) ) ) * varianceGamma;
	let minColor = mean - variance;
	let maxColor = mean + variance;
// TRACE243_BEGIN variance
	trace243_write(11u, mean);
	trace243_write(12u, variance);
	trace243_write(13u, minColor);
	trace243_write(14u, maxColor);
// TRACE243_END variance

	let historyColor = taauSampleHistory( historyUV );
	let clippedHistoryColor = taauClipAABB( clamp( mean, minColor, maxColor ), historyColor, minColor, maxColor );
// TRACE243_BEGIN actual-history
	trace243_write(16u, historyColor);
	trace243_write(17u, clippedHistoryColor);
// TRACE243_END actual-history

	// thin features lock the history a little (less flicker on wires, masts, leaves)
	let meanLuma = luminance( mean.rgb );
	let thinFeature = smoothstep( 0.0, 0.2, abs( luminance( currentColor.rgb ) - meanLuma ) / meanLuma );
	let isDepthChanged = abs( closestDepth - previousDepth ) > taau.depthThreshold;
	let canLock = isValidUV && ! isDepthChanged;
	let gatedThinFeature = select( 0.0, thinFeature, canLock );
	let lock = sat( gatedThinFeature );
	let lockedHistoryColor = mix( clippedHistoryColor, historyColor, lock );
// TRACE243_BEGIN thin-lock
	trace243_write(6u, vec4f(f32(hasValidHistory), f32(canLock), f32(isDepthChanged), gatedThinFeature));
	trace243_write(8u, vec4f(sumWeight, meanLuma, thinFeature, lock));
	trace243_write(18u, lockedHistoryColor);
// TRACE243_END thin-lock

	// fast camera motion trusts the current frame more; capped on water, whose fine detail shimmers under the jitter
	let motionW = select( motionFactor, min( motionFactor, 0.15 ), isWater );
	let currentWeight = select( 1.0, sat( taau.frameWeight + motionW ), hasValidHistory );
// TRACE243_BEGIN motion
	trace243_write(19u, vec4f(motionFactor, varianceGamma, motionW, currentWeight));
// TRACE243_END motion
	return taauFlickerReduction( currentColor, lockedHistoryColor, currentWeight );
}

// TRACE243_BEGIN entry-wrapper
@fragment fn fs( in: FSIn ) -> @location( 0 ) vec4f {
    let result = fragment(in);
    if (trace243_site < 8u && trace243_site < trace243_selection.header.x) {
        trace243_write(30u, result);
        trace243_write(31u, textureLoad(trace243_original_output, vec2i(in.pos.xy), 0));
        trace243_write(63u, vec4f(1.0, 1.0, f32(trace243_site),
            f32(trace243_selection.sites[trace243_site].z)));
    }
    return result;
}

// TRACE243_END entry-wrapper
