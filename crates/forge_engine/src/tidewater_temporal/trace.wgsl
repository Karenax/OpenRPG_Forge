// TRACE243_BEGIN declarations

// This separate pass never binds a visual/history/depth target for writing.
// Fullscreen source equations below remain byte-recoverable after removing stores.
// Instrumentation can perturb compilation: compare private scratch RGBA16F to
// actual original resolve output BEFORE attributing these intermediates to it.
struct Trace243Selection {
    // count<=8, record capacity=64 vec4f, dimensions are actual output dimensions.
    header: vec4u,
    sites: array<vec4u, 8>, // x, y, case_id, reserved
};
struct Trace243Data { values: array<vec4f> };
@group(2) @binding(0) var<uniform> trace243_selection: Trace243Selection;
@group(2) @binding(1) var<storage, read_write> trace243_data: Trace243Data;
@group(2) @binding(2) var trace243_original_output: texture_2d<f32>;
var<private> trace243_site: u32;
var<private> trace243_depth_slot: u32;
var<private> trace243_current_raw_depth: f32;

fn trace243_write(slot: u32, value: vec4f) {
    if (trace243_site < 8u && trace243_selection.header.x <= 8u &&
        trace243_site < trace243_selection.header.x && slot < 64u) {
        trace243_data.values[trace243_site * 64u + slot] = value;
    }
}

fn trace243_begin(input: FSIn) {
    trace243_site = 8u;
    trace243_depth_slot = 64u;
    trace243_current_raw_depth = 0.0;
    let pixel = vec2u(input.pos.xy);
    if (trace243_selection.header.x > 8u || trace243_selection.header.y != 64u ||
        any(trace243_selection.header.zw != tidewater_temporal_packet.sizes.zw) ||
        any(trace243_selection.header.zw != vec2u(textureDimensions(trace243_original_output)))) {
        return;
    }
    for (var i = 0u; i < trace243_selection.header.x; i++) {
        if (all(pixel == trace243_selection.sites[i].xy)) {
            trace243_site = i;
            // A unique pixel invocation owns this record; no atomics/CPU fake data.
            for (var s = 0u; s < 64u; s++) { trace243_write(s, vec4f(0.0)); }
            trace243_write(0u, vec4f(input.pos.xy, input.uv));
            trace243_write(63u, vec4f(1.0, 0.0, f32(i),
                f32(trace243_selection.sites[i].z)));
            return;
        }
    }
}

