      "kind": "entry",
      "index": 4,
      "text": {
        "stringRef": null,
        "values": [
          {
            "languageId": 0,
            "text": "Le pont tient. Merci, voyageur."
          }
        ]
      },
      "displayText": "Le pont tient. Merci, voyageur.",
      "speaker": null,
      "comment": null,
      "animation": 0,
