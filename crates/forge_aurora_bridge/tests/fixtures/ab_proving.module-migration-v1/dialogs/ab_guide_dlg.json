      "sound": null,
      "quest": null,
      "actionScript": null
    },
    {
      "id": "entry:2",
      "kind": "entry",
      "index": 2,
      "text": {
        "stringRef": null,
        "values": [
          {
            "languageId": 0,
            "text": "La crypte est au-delà de la porte. Le gardien n'aime pas les visiteurs."
          }
        ]
      },
      "displayText": "La crypte est au-delà de la porte. Le gardien n'aime pas les visiteurs.",
      "speaker": null,
      "comment": null,
      "animation": 0,
      "animationLoop": true,
      "sound": null,
      "quest": null,
      "actionScript": null
    },
    {
      "id": "entry:3",
      "kind": "entry",
      "index": 3,
      "text": {
        "stringRef": null,
        "values": [
          {
            "languageId": 0,
            "text": "Tu l'as trouvée ! Le pont est sauvé. Prends cette bourse, tu l'as méritée."
          }
        ]
      },
      "displayText": "Tu l'as trouvée ! Le pont est sauvé. Prends cette bourse, tu l'as méritée.",
      "speaker": null,
      "comment": null,
      "animation": 0,
      "animationLoop": true,
      "sound": null,
      "quest": null,
      "actionScript": null
    },
    {
