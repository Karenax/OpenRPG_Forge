      "index": 0,
      "text": {
        "stringRef": null,
        "values": [
          {
            "languageId": 0,
            "text": "Le pont de pierre ne tient plus que par un fil. Que veux-tu savoir ?"
          }
        ]
      },
      "displayText": "Le pont de pierre ne tient plus que par un fil. Que veux-tu savoir ?",
      "speaker": null,
      "comment": null,
      "animation": 0,
      "animationLoop": true,
      "sound": null,
      "quest": null,
      "actionScript": null
    },
    {
      "id": "entry:1",
      "kind": "entry",
      "index": 1,
      "text": {
        "stringRef": null,
        "values": [
          {
            "languageId": 0,
            "text": "Rapporte-moi la relique de la crypte et je pourrai réparer le pont."
          }
        ]
      },
      "displayText": "Rapporte-moi la relique de la crypte et je pourrai réparer le pont.",
      "speaker": null,
      "comment": null,
      "animation": 0,
