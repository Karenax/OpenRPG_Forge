; OpenRPG isolated workspace worker. Third-party addons are installed from pinned manifests.
config_version=5

[application]

config/name="OpenRPG World Generation Workspace Worker"

[autoload]

OpenRPGWorldGenerationBackend="*res://addons/openrpg_world_generation/openrpg_world_generation_backend.gd"
OpenRPGWorldGenerationJobs="*res://addons/openrpg_world_generation/world_generation_job_runner.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/terrain_3d/plugin.cfg", "res://addons/flow_nodes_editor/plugin.cfg")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
