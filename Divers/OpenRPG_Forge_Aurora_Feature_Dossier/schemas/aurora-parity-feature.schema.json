{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openrpgforge.invalid/schemas/aurora-parity-feature.schema.json",
  "title": "OpenRPG Forge Aurora parity feature",
  "type": "object",
  "required": [
    "id",
    "domain",
    "title",
    "priority",
    "layer",
    "scope",
    "aurora",
    "forge",
    "acceptance_criteria"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ORF-[A-Z]+-[0-9]{3}$"
    },
    "domain": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3",
        "P4"
      ]
    },
    "layer": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "aurora": {
      "type": "string"
    },
    "forge": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
