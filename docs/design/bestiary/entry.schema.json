{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openrpg-forge.bestiary.entry.fr.v0.1",
  "title": "Entrée du Bestiaire OpenRPG Forge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "creature_id",
    "name",
    "subtitle",
    "editorial_status",
    "canonicality",
    "major",
    "classification",
    "physique",
    "habitats",
    "ecology",
    "senses",
    "communication",
    "signs",
    "demeanor",
    "rules",
    "field_knowledge",
    "encounter_use",
    "salvage",
    "plates"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "creature_id": { "type": "string", "pattern": "^creature\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 3 },
    "subtitle": { "type": "string", "minLength": 8 },
    "editorial_status": { "const": "design-proposal-not-implemented" },
    "canonicality": { "enum": ["historical-anchor", "new-design-proposal"] },
    "origin_notes": { "type": "string" },
    "illustration_status": { "enum": ["illustrated", "planned"] },
    "major": { "type": "boolean" },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nature", "family", "rarity", "activity", "social", "threat", "threat_reason"],
      "properties": {
        "nature": { "type": "string" },
        "family": { "type": "string" },
        "rarity": { "type": "string" },
        "activity": { "type": "string" },
        "social": { "type": "string" },
        "threat": { "enum": ["faible", "moderee", "forte", "critique", "majeure"] },
        "threat_reason": { "type": "string", "minLength": 30 }
      }
    },
    "physique": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensions", "mass_kg", "locomotion", "center_of_gravity", "silhouette", "anatomy_zones"],
      "properties": {
        "dimensions": { "type": "string" },
        "mass_kg": {
          "type": "array",
          "prefixItems": [{ "type": "number", "minimum": 0.05 }, { "type": "number", "minimum": 0.05 }],
          "items": false
        },
        "locomotion": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "center_of_gravity": { "type": "string" },
        "silhouette": { "type": "string" },
        "anatomy_zones": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["zone", "description", "protection"],
            "properties": {
              "zone": { "type": "string" },
              "description": { "type": "string" },
              "protection": { "type": "integer", "minimum": 0, "maximum": 40 }
            }
          }
        }
      }
    },
    "habitats": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "ecology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diet", "lifecycle", "reproduction", "behavior", "niche", "environmental_impact"],
      "properties": {
        "diet": { "type": "string" },
        "lifecycle": { "type": "string" },
        "reproduction": { "type": "string" },
        "behavior": { "type": "string" },
        "niche": { "type": "string" },
        "environmental_impact": { "type": "string" }
      }
    },
    "senses": { "type": "array", "minItems": 2, "items": { "type": "string" } },
    "communication": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "signs": { "type": "array", "minItems": 3, "items": { "type": "string" } },
    "demeanor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectives", "fears", "morale", "escalation", "retreat"],
      "properties": {
        "objectives": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "fears": { "type": "array", "items": { "type": "string" } },
        "morale": { "type": "string" },
        "escalation": { "type": "string" },
        "retreat": { "type": "string" }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attributes", "skills", "resources", "movement", "protections", "attacks", "abilities", "resistances", "vulnerabilities", "immunities", "environmental_interactions"],
      "properties": {
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strength", "dexterity", "constitution", "intelligence", "willpower", "perception", "presence"],
          "properties": {
            "strength": { "$ref": "#/$defs/attribute" },
            "dexterity": { "$ref": "#/$defs/attribute" },
            "constitution": { "$ref": "#/$defs/attribute" },
            "intelligence": { "$ref": "#/$defs/attribute" },
            "willpower": { "$ref": "#/$defs/attribute" },
            "perception": { "$ref": "#/$defs/attribute" },
            "presence": { "$ref": "#/$defs/attribute" }
          }
        },
        "skills": {
          "type": "object",
          "minProperties": 4,
          "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 100 }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vitality", "stamina", "mana", "balance", "focus"],
          "properties": {
            "vitality": { "type": "integer", "minimum": 1 },
            "stamina": { "type": "integer", "minimum": 1 },
            "mana": { "type": "integer", "minimum": 0 },
            "balance": { "type": "integer", "minimum": 1 },
            "focus": { "type": "integer", "minimum": 1 }
          }
        },
        "movement": { "type": "string" },
        "protections": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "attacks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/action" } },
        "abilities": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "resistances": { "type": "array", "items": { "$ref": "#/$defs/interaction" } },
        "vulnerabilities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/interaction" } },
        "immunities": { "type": "array", "items": { "$ref": "#/$defs/interaction" } },
        "environmental_interactions": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/environment" } }
      }
    },
    "field_knowledge": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "skill_id", "difficulty", "fact"],
        "properties": {
          "status": { "enum": ["etabli", "suppose", "secret"] },
          "skill_id": { "enum": ["lore", "tracking", "investigation", "vigilance", "animal_handling"] },
          "difficulty": { "enum": [14, 18, 22, 26, 30, 34] },
          "fact": { "type": "string", "minLength": 20 }
        }
      }
    },
    "encounter_use": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles", "telegraphs", "noncombat_options", "complications"],
      "properties": {
        "roles": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "telegraphs": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "noncombat_options": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "complications": { "type": "array", "items": { "type": "string" } }
      }
    },
    "salvage": { "type": "array", "items": { "type": "string" } },
    "plates": {
      "type": "array",
      "minItems": 0,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["image", "alt", "caption", "prompt_key"],
        "properties": {
          "image": { "type": "string", "pattern": "^[a-z0-9-]+\\.png$" },
          "alt": { "type": "string", "minLength": 40 },
          "caption": { "type": "string", "minLength": 20 },
          "prompt_key": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        }
      }
    },
    "major_dossier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arena", "sequence", "causal_opportunities", "aftermath"],
      "properties": {
        "arena": { "type": "string" },
        "sequence": { "type": "array", "minItems": 3, "items": { "type": "string" } },
        "causal_opportunities": { "type": "array", "minItems": 3, "items": { "type": "string" } },
        "aftermath": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": { "required": ["illustration_status"], "properties": { "illustration_status": { "const": "planned" } } },
      "then": { "properties": { "plates": { "maxItems": 0 }, "major": { "const": false } } },
      "else": { "properties": { "plates": { "minItems": 1 } } }
    }
  ],
  "$defs": {
    "attribute": { "type": "integer", "minimum": 1, "maximum": 10 },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "visibility", "skill_id", "attribute_id", "impact", "reach", "stamina_cost", "preparation", "telegraph", "effect", "counterplay"],
      "properties": {
        "name": { "type": "string" },
        "kind": { "enum": ["attack", "ability"] },
        "visibility": { "enum": ["etablie", "supposee", "secrete"] },
        "skill_id": { "type": "string" },
        "attribute_id": { "type": "string" },
        "impact": { "type": "integer", "minimum": 0, "maximum": 100 },
        "reach": { "type": "string" },
        "stamina_cost": { "type": "integer", "minimum": 0, "maximum": 100 },
        "preparation": { "type": "string" },
        "telegraph": { "type": "string" },
        "effect": { "type": "string" },
        "counterplay": { "type": "string" }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "mechanism"],
      "properties": {
        "subject": { "type": "string" },
        "mechanism": { "type": "string", "minLength": 15 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "result", "chain"],
      "properties": {
        "input": { "type": "string" },
        "result": { "type": "string" },
        "chain": { "type": "string", "minLength": 20 }
      }
    }
  }
}
