    {
      "id": "P1_REVISION_DOMAIN",
      "status": "FIXED IN QUALIFIED SOURCE",
      "original_defect": "Studio used WorkspaceDocument.revision while the renderer sampled PlacementDocument.revision, causing false stale results after unrelated edits",
      "correction": "Studio scope and sample application use area.placements.revision",
      "regression_test": "unrelated_workspace_revision_does_not_invalidate_the_exact_placement_projection"
    },
    {
      "id": "P2_CLICK_DRAG_EXCLUSIVITY",
      "status": "FIXED IN QUALIFIED SOURCE",
      "original_defect": "subthreshold motion moved the camera while still producing a click, and final pointerup travel was omitted",
      "correction": "zero-delta buffering, exact catch-up, final pointerup move_to and non-consuming wrong-pointer handling",
      "regression_test": "camera_motion_is_buffered_until_drag_threshold_then_catches_up_exactly"
    }
  ],
