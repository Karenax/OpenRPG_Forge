{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openrpg-forge:schema:forge.visual-proof:1",
  "title": "OpenRPG Forge visual and performance proof v1",
  "description": "Common capture and metric envelope for Forge native, Forge WebGPU/Studio and the pinned Cadle baseline. It stores metadata and hashes, never Cadle media.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "recorded_at_utc",
    "subject",
    "environment",
    "protocol",
    "metrics",
    "captures",
    "review",
    "validation"
  ],
  "properties": {
    "schema": {
      "const": "forge.visual-proof"
    },
    "schema_version": {
      "const": 1
    },
    "recorded_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "protocol": {
      "$ref": "#/$defs/protocol"
    },
    "metrics": {
      "$ref": "#/$defs/metrics"
    },
    "captures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/capture"
      }
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "comparison": {
      "$ref": "#/$defs/comparison"
    },
    "validation": {
      "$ref": "#/$defs/validation"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "non_blank_string": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "non_negative_number": {
      "type": "number",
      "minimum": 0
    },
    "positive_number": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "non_negative_integer": {
      "type": "integer",
      "minimum": 0
    },
    "positive_integer": {
      "type": "integer",
      "minimum": 1
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "target",
        "gate",
        "commit_sha",
        "source_tree_clean",
        "scene_id"
      ],
      "properties": {
        "product": {
          "enum": ["forge", "cadle"]
        },
        "target": {
          "enum": [
            "native_runtime",
            "wasm_browser",
            "tauri_studio",
            "cadle_browser"
          ]
        },
        "gate": {
          "type": "string",
          "pattern": "^Gate (C|[0-9]+)$"
        },
        "commit_sha": {
          "$ref": "#/$defs/git_commit"
        },
        "source_tree_clean": {
          "type": "boolean"
        },
        "scene_id": {
          "$ref": "#/$defs/non_blank_string"
        },
        "scene_document_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "build_profile": {
          "$ref": "#/$defs/non_blank_string"
        }
      }
    },
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "backend"],
      "properties": {
        "name": {
          "$ref": "#/$defs/non_blank_string"
        },
        "vendor_id": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "device_id": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "device_type": {
          "$ref": "#/$defs/non_blank_string"
        },
        "backend": {
          "$ref": "#/$defs/non_blank_string"
        },
        "driver": {
          "$ref": "#/$defs/non_blank_string"
        },
        "driver_info": {
          "type": "string"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "version"],
      "properties": {
        "kind": {
          "enum": ["native", "browser", "webview"]
        },
        "name": {
          "$ref": "#/$defs/non_blank_string"
        },
        "version": {
          "$ref": "#/$defs/non_blank_string"
        },
        "renderer": {
          "$ref": "#/$defs/non_blank_string"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "cpu", "gpu", "runtime"],
      "properties": {
        "os": {
          "$ref": "#/$defs/non_blank_string"
        },
        "architecture": {
          "$ref": "#/$defs/non_blank_string"
        },
        "cpu": {
          "$ref": "#/$defs/non_blank_string"
        },
        "logical_cpu_count": {
          "$ref": "#/$defs/positive_integer"
        },
        "ram_bytes": {
          "$ref": "#/$defs/positive_integer"
        },
        "gpu": {
          "$ref": "#/$defs/gpu"
        },
        "runtime": {
          "$ref": "#/$defs/runtime"
        }
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_px", "height_px", "device_scale_factor"],
      "properties": {
        "width_px": {
          "$ref": "#/$defs/positive_integer"
        },
        "height_px": {
          "$ref": "#/$defs/positive_integer"
        },
        "device_scale_factor": {
          "$ref": "#/$defs/positive_number"
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "viewport",
        "quality_profile",
        "vsync",
        "seed",
        "one_percent_low_method"
      ],
      "allOf": [
        {
          "anyOf": [
            {
              "required": ["warmup_seconds"]
            },
            {
              "required": ["warmup_frames"]
            }
          ]
        },
        {
          "anyOf": [
            {
              "required": ["sample_seconds"]
            },
            {
              "required": ["sample_frames"]
            }
          ]
        }
      ],
      "properties": {
        "viewport": {
          "$ref": "#/$defs/viewport"
        },
        "quality_profile": {
          "$ref": "#/$defs/non_blank_string"
        },
        "vsync": {
          "type": "boolean"
        },
        "warmup_seconds": {
          "$ref": "#/$defs/non_negative_number"
        },
        "warmup_frames": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "sample_seconds": {
          "$ref": "#/$defs/positive_number"
        },
        "sample_frames": {
          "$ref": "#/$defs/positive_integer"
        },
        "seed": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "$ref": "#/$defs/non_blank_string"
            }
          ]
        },
        "one_percent_low_method": {
          "const": "inverse_mean_slowest_1_percent_frame_time"
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_blank_string"
          }
        }
      }
    },
    "frame_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "samples",
        "duration_ms",
        "mean_ms",
        "p95_ms",
        "p99_ms",
        "max_ms",
        "one_percent_low_fps",
        "hitches_over_16_7_ms",
        "hitches_over_33_3_ms"
      ],
      "properties": {
        "samples": {
          "$ref": "#/$defs/positive_integer"
        },
        "duration_ms": {
          "$ref": "#/$defs/positive_number"
        },
        "mean_ms": {
          "$ref": "#/$defs/positive_number"
        },
        "p50_ms": {
          "$ref": "#/$defs/positive_number"
        },
        "p95_ms": {
          "$ref": "#/$defs/positive_number"
        },
        "p99_ms": {
          "$ref": "#/$defs/positive_number"
        },
        "max_ms": {
          "$ref": "#/$defs/positive_number"
        },
        "mean_fps": {
          "$ref": "#/$defs/positive_number"
        },
        "one_percent_low_fps": {
          "$ref": "#/$defs/positive_number"
        },
        "hitches_over_16_7_ms": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "hitches_over_33_3_ms": {
          "$ref": "#/$defs/non_negative_integer"
        }
      }
    },
    "stage_timing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mean_ms": {
          "$ref": "#/$defs/non_negative_number"
        },
        "p95_ms": {
          "$ref": "#/$defs/non_negative_number"
        }
      },
      "minProperties": 1
    },
    "render_work": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "draw_calls": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "logical_draws": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "triangles": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "instances": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "source_entities": {
          "$ref": "#/$defs/non_negative_integer"
        }
      },
      "minProperties": 1
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "process_rss_mib": {
          "$ref": "#/$defs/non_negative_number"
        },
        "js_heap_mib": {
          "$ref": "#/$defs/non_negative_number"
        },
        "wasm_linear_mib": {
          "$ref": "#/$defs/non_negative_number"
        },
        "vram_mib": {
          "$ref": "#/$defs/non_negative_number"
        }
      },
      "minProperties": 1
    },
    "loading": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startup_ms": {
          "$ref": "#/$defs/non_negative_number"
        },
        "scene_ready_ms": {
          "$ref": "#/$defs/non_negative_number"
        },
        "pipeline_warmup_ms": {
          "$ref": "#/$defs/non_negative_number"
        }
      },
      "minProperties": 1
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame"],
      "properties": {
        "frame": {
          "$ref": "#/$defs/frame_metrics"
        },
        "cpu": {
          "$ref": "#/$defs/stage_timing"
        },
        "gpu": {
          "$ref": "#/$defs/stage_timing"
        },
        "render_work": {
          "$ref": "#/$defs/render_work"
        },
        "memory": {
          "$ref": "#/$defs/memory"
        },
        "loading": {
          "$ref": "#/$defs/loading"
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "target",
        "storage",
        "sha256",
        "width_px",
        "height_px",
        "non_blank"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/non_blank_string"
        },
        "target": {
          "enum": [
            "native_runtime",
            "wasm_browser",
            "studio_window",
            "cadle_browser"
          ]
        },
        "storage": {
          "enum": ["tracked", "local_ignored", "external"]
        },
        "locator": {
          "$ref": "#/$defs/non_blank_string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "width_px": {
          "$ref": "#/$defs/positive_integer"
        },
        "height_px": {
          "$ref": "#/$defs/positive_integer"
        },
        "frame_index": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "non_blank": {
          "type": "boolean"
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_blank_string"
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "method", "notes"],
      "properties": {
        "status": {
          "enum": ["inspected", "uninspected", "rejected"]
        },
        "method": {
          "enum": ["human", "automated_then_human"]
        },
        "notes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_blank_string"
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "protocol_equivalence", "notes"],
      "properties": {
        "reference": {
          "$ref": "#/$defs/non_blank_string"
        },
        "protocol_equivalence": {
          "enum": ["equivalent", "bounded_difference", "not_comparable"]
        },
        "notes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_blank_string"
          }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "evidence"],
      "properties": {
        "id": {
          "$ref": "#/$defs/non_blank_string"
        },
        "status": {
          "enum": ["pass", "fail", "not_run"]
        },
        "evidence": {
          "$ref": "#/$defs/non_blank_string"
        },
        "command": {
          "$ref": "#/$defs/non_blank_string"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall", "checks", "limitations"],
      "properties": {
        "overall": {
          "enum": ["pass", "fail", "partial"]
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_blank_string"
          }
        }
      }
    }
  }
}
