<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>OpenRPG_Forge_Creator</AssemblyName>
    <RootNamespace>Forge.CreatorLauncher</RootNamespace>
    <ApplicationIcon>openrpg_forge.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <FileVersion>0.1.0.0</FileVersion>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <Authors>OpenRPG Forge</Authors>
    <Company>OpenRPG Forge</Company>
    <Product>OpenRPG Forge Creator</Product>
    <Description>Launches the portable OpenRPG Forge Creator workspace.</Description>
  </PropertyGroup>
</Project>
