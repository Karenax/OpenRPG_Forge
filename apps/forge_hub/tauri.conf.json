{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenRPG Forge — Gestionnaire de contenu",
  "version": "0.1.0",
  "identifier": "org.openrpg.forge.hub",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "OpenRPG Forge — Gestionnaire de contenu", "width": 1100, "height": 760, "minWidth": 900, "minHeight": 650 }],
    "security": { "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'" }
  },
  "bundle": { "active": false }
}
