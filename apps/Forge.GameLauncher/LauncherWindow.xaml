<Window x:Class="Forge.GameLauncher.LauncherWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="OpenRPG Forge"
        Width="1360"
        Height="800"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#070910"
        Foreground="#F4EEE2"
        FontFamily="{StaticResource BodyFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Loaded="OnLoaded"
        Closed="OnClosed"
        MouseMove="OnWindowMouseMove">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="7"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#C88A52" />
        <SolidColorBrush x:Key="AccentBrightBrush" Color="#F0BF78" />
        <SolidColorBrush x:Key="TextBrush" Color="#F4EEE2" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#B8AFA4" />
        <SolidColorBrush x:Key="DimTextBrush" Color="#817A75" />
        <SolidColorBrush x:Key="PanelBrush" Color="#E60A0D14" />
        <SolidColorBrush x:Key="FieldBrush" Color="#B91B1C24" />
        <SolidColorBrush x:Key="FieldHoverBrush" Color="#E026252E" />
        <SolidColorBrush x:Key="HairlineBrush" Color="#69685146" />
        <SolidColorBrush x:Key="DangerBrush" Color="#F09880" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#A8D5A8" />

        <DropShadowEffect x:Key="PanelShadow"
                          Color="#000000"
                          BlurRadius="36"
                          ShadowDepth="10"
                          Opacity="0.7" />
        <DropShadowEffect x:Key="SoftGlow"
                          Color="#BD7B43"
                          BlurRadius="18"
                          ShadowDepth="0"
                          Opacity="0.42" />

        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Foreground" Value="#C8C1B8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChromeSurface" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeSurface" Property="Background" Value="#453A3530" />
                                <Setter Property="Foreground" Value="#FFF1D8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChromeSurface" Property="Background" Value="#76513B2F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#948C83" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,28,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Height="42">
                            <Border x:Name="NavSurface" Background="Transparent" />
                            <StackPanel VerticalAlignment="Center">
                                <ContentPresenter HorizontalAlignment="Center" />
                                <Border x:Name="NavMark"
                                        Height="2"
                                        Width="0"
                                        Margin="0,9,0,0"
                                        Background="{DynamicResource AccentBrightBrush}" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E6D8C2" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#FFF4DD" />
                                <Setter TargetName="NavMark" Property="Width" Value="34" />
                                <Setter TargetName="NavMark" Property="Effect" Value="{StaticResource SoftGlow}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.28" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#160F0B" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="58" />
            <Setter Property="Padding" Value="30,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Glow"
                                    Margin="5"
                                    CornerRadius="3"
                                    Background="{DynamicResource AccentBrush}"
                                    Opacity="0.25"
                                    Effect="{StaticResource SoftGlow}" />
                            <Border x:Name="PrimarySurface"
                                    CornerRadius="3"
                                    BorderBrush="#FFFFD9A1"
                                    BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFE2A65E" Offset="0" />
                                        <GradientStop Color="#FFB96B38" Offset="0.55" />
                                        <GradientStop Color="#FF8E462B" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Border Height="1"
                                            Margin="12,4,12,0"
                                            VerticalAlignment="Top"
                                            Background="#AFFFF0C6" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glow" Property="Opacity" Value="0.72" />
                                <Setter TargetName="PrimarySurface" Property="BorderBrush" Value="#FFFFFFFF" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.018" ScaleY="1.018" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.985" ScaleY="0.985" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#D8CFC3" />
            <Setter Property="Background" Value="#B51C1D25" />
            <Setter Property="BorderBrush" Value="#6B75604D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SecondarySurface"
                                CornerRadius="2"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SecondarySurface" Property="Background" Value="#E02A2527" />
                                <Setter TargetName="SecondarySurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="#FFF0DA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SecondarySurface" Property="Background" Value="#F0382D29" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldTextStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrightBrush}" />
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="FieldSurface"
                                CornerRadius="2"
                                 Background="{TemplateBinding Background}"
                                 BorderBrush="{TemplateBinding BorderBrush}"
                                 BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}"
                                          Focusable="False"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="FieldSurface" Property="Background" Value="{StaticResource FieldHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.32" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#FA171820" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemSurface" Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#F03B2D27" />
                                <Setter Property="Foreground" Value="#FFFFE4BD" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#F0463227" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldComboStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                          Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                          BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                          BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboSurface"
                                                CornerRadius="2"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="42" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="12,0,4,0"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <Border Grid.Column="1" BorderBrush="#3DFFFFFF" BorderThickness="1,0,0,0">
                                                    <Path Width="9"
                                                          Height="5"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Data="M 0 0 L 4.5 5 L 9 0 Z"
                                                          Fill="{DynamicResource AccentBrightBrush}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboSurface" Property="Background" Value="{StaticResource FieldHoverBrush}" />
                                                <Setter TargetName="ComboSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ComboSurface" Property="BorderBrush" Value="{DynamicResource AccentBrightBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="260"
                                        Margin="0,4,0,0"
                                        Background="#FC12131A"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        Effect="{StaticResource PanelShadow}">
                                    <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RpgCheckStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D9D1C7" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckSurface"
                                    Width="17"
                                    Height="17"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="#C51B1C24"
                                    BorderBrush="#8B75604D"
                                    BorderThickness="1"
                                    CornerRadius="2">
                                <Path x:Name="CheckMark"
                                      Width="10"
                                      Height="8"
                                      Data="M 0 4 L 3.5 7.5 L 10 0"
                                      Stroke="#FFFFD391"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                <Setter TargetName="CheckSurface" Property="BorderBrush" Value="{DynamicResource AccentBrightBrush}" />
                                <Setter TargetName="CheckSurface" Property="Background" Value="#D3463024" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RpgSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="28" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="3" Background="#85615A57" CornerRadius="2" />
                            <primitives:Track x:Name="PART_Track" VerticalAlignment="Center">
                                <primitives:Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Background="{DynamicResource AccentBrush}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="3" Background="{TemplateBinding Background}" CornerRadius="2" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </primitives:Track.DecreaseRepeatButton>
                                <primitives:Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Background="Transparent">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </primitives:Track.IncreaseRepeatButton>
                                <primitives:Track.Thumb>
                                    <Thumb Width="16" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Fill="#F9EEE0CB"
                                                             Stroke="{DynamicResource AccentBrush}"
                                                             StrokeThickness="2"
                                                             Effect="{StaticResource SoftGlow}" />
                                                    <Ellipse Width="4" Height="4" Fill="#FF6D3D28" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </primitives:Track.Thumb>
                            </primitives:Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeCardStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#DDD5CB" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ModeSurface"
                                MinHeight="82"
                                Padding="15,13"
                                Background="#A817181F"
                                BorderBrush="#5662554A"
                                BorderThickness="1"
                                CornerRadius="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="27" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="17" Height="17" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Ellipse Stroke="#A48A7764" StrokeThickness="1" Fill="#B7191A20" />
                                    <Ellipse x:Name="ModeDot" Width="7" Height="7" Fill="{DynamicResource AccentBrightBrush}" Visibility="Collapsed" />
                                </Grid>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModeSurface" Property="Background" Value="#D525211F" />
                                <Setter TargetName="ModeSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeSurface" Property="Background" Value="#E0332821" />
                                <Setter TargetName="ModeSurface" Property="BorderBrush" Value="{DynamicResource AccentBrightBrush}" />
                                <Setter TargetName="ModeDot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.25" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlineStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFF4E6" />
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="31" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#BEB4A9" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="19" />
        </Style>
        <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C8BFB5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootVisual" ClipToBounds="True">
        <Image x:Name="BackdropImage"
               Source="Assets/launcher-dark-citadel-v1.png"
               Stretch="UniformToFill"
               RenderOptions.BitmapScalingMode="HighQuality">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="1.06" ScaleY="1.06" />
                    <TranslateTransform x:Name="BackdropTranslate" />
                </TransformGroup>
            </Image.RenderTransform>
        </Image>

        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#3A05070C" Offset="0" />
                    <GradientStop Color="#6505070C" Offset="0.43" />
                    <GradientStop Color="#D8080A10" Offset="0.67" />
                    <GradientStop Color="#F7070910" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#69000000" Offset="0" />
                    <GradientStop Color="#00000000" Offset="0.32" />
                    <GradientStop Color="#15000000" Offset="0.67" />
                    <GradientStop Color="#D9000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Canvas x:Name="AtmosphereCanvas" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse x:Name="FogBandOne"
                     Canvas.Left="-220"
                     Canvas.Top="530"
                     Width="1100"
                     Height="250"
                     Opacity="0.17">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#B5B6C9D5" Offset="0" />
                        <GradientStop Color="#00B6C9D5" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="55" />
                </Ellipse.Effect>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="FogTranslateOne" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="FogBandTwo"
                     Canvas.Left="360"
                     Canvas.Top="610"
                     Width="1050"
                     Height="210"
                     Opacity="0.11">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#D4927D6D" Offset="0" />
                        <GradientStop Color="#00927D6D" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="60" />
                </Ellipse.Effect>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="FogTranslateTwo" />
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>
        <Canvas x:Name="ParticleCanvas" IsHitTestVisible="False" ClipToBounds="True" />

        <Grid x:Name="HeroIdentity"
              Width="470"
              Margin="62,0,0,62"
              HorizontalAlignment="Left"
              VerticalAlignment="Bottom"
              Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="HeroTranslate" Y="24" />
            </Grid.RenderTransform>
            <StackPanel>
                <Grid Width="74" Height="74" HorizontalAlignment="Left" Margin="0,0,0,22">
                    <Ellipse Stroke="#9DD7A868" StrokeThickness="1" />
                    <Ellipse Margin="7" Stroke="#62876A47" StrokeThickness="1" />
                    <Path Width="31"
                          Height="37"
                          Stretch="Fill"
                          Data="M 15.5 0 L 28 12 L 22 31 L 15.5 37 L 9 31 L 3 12 Z M 15.5 7 L 20 16 L 15.5 27 L 11 16 Z"
                          Fill="#1A000000"
                          Stroke="{DynamicResource AccentBrightBrush}"
                          StrokeThickness="1.2"
                          Effect="{StaticResource SoftGlow}" />
                </Grid>
                <TextBlock Text="OPENRPG FORGE  /  AVENTURE"
                           Style="{StaticResource OverlineStyle}"
                           Margin="0,0,0,14" />
                <TextBlock x:Name="GameTitleText"
                           MaxWidth="460"
                           Foreground="#FFF6E9"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="42"
                           FontWeight="Bold"
                           LineHeight="45"
                           TextWrapping="Wrap"
                           TextOptions.TextFormattingMode="Display" />
                <Grid Width="248" Height="12" HorizontalAlignment="Left" Margin="0,18,0,18">
                    <Border Height="1" VerticalAlignment="Center" Background="#9FCB965D" />
                    <Path Width="11"
                          Height="11"
                          HorizontalAlignment="Left"
                          Data="M 5.5 0 L 11 5.5 L 5.5 11 L 0 5.5 Z"
                          Fill="{DynamicResource AccentBrightBrush}" />
                </Grid>
                <TextBlock x:Name="TaglineText"
                           MaxWidth="410"
                           Foreground="#E1D7C9"
                           FontSize="14"
                           LineHeight="22"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,9,0" VerticalAlignment="Center" />
                    <TextBlock Text="DISTRIBUTION VÉRIFIÉE"
                               Foreground="#B9C6B6"
                               FontSize="9"
                               FontWeight="Bold" />
                    <Border Width="1" Height="12" Background="#67776C61" Margin="15,0" />
                    <TextBlock x:Name="VersionText"
                               Foreground="#9B9288"
                               FontSize="9"
                               FontWeight="SemiBold" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Border x:Name="CommandPanel"
                Width="690"
                Margin="0,70,46,42"
                HorizontalAlignment="Right"
                Background="{StaticResource PanelBrush}"
                BorderBrush="#856E5947"
                BorderThickness="1"
                CornerRadius="7"
                Effect="{StaticResource PanelShadow}"
                Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="PanelTranslate" X="36" />
            </Border.RenderTransform>
            <Grid>
                <Border Height="2" Margin="28,0" VerticalAlignment="Top">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00C88A52" Offset="0" />
                            <GradientStop Color="#E8E5B66E" Offset="0.5" />
                            <GradientStop Color="#00C88A52" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Path Width="13" Height="13" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top"
                      Data="M 0 0 L 13 0 L 13 2 L 2 2 L 2 13 L 0 13 Z" Fill="{DynamicResource AccentBrush}" />
                <Path Width="13" Height="13" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                      Data="M 0 0 L 13 0 L 13 13 L 11 13 L 11 2 L 0 2 Z" Fill="{DynamicResource AccentBrush}" />

                <Grid Margin="40,31,40,26">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="48" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <RadioButton x:Name="HomeNavigation"
                                     Content="ACCUEIL"
                                     GroupName="Navigation"
                                     IsChecked="True"
                                     Style="{StaticResource NavRadioStyle}"
                                     Checked="OnNavigationChecked"
                                     Tag="home" />
                        <RadioButton x:Name="SettingsNavigation"
                                     Content="CONFIGURATION"
                                     GroupName="Navigation"
                                     Style="{StaticResource NavRadioStyle}"
                                     Checked="OnNavigationChecked"
                                     Tag="settings" />
                        <RadioButton x:Name="MultiplayerNavigation"
                                     Content="MULTIJOUEUR"
                                     GroupName="Navigation"
                                     Style="{StaticResource NavRadioStyle}"
                                     Checked="OnNavigationChecked"
                                     Tag="multiplayer" />
                    </StackPanel>

                    <Grid x:Name="PageHost" Grid.Row="1" ClipToBounds="True">
                        <Grid x:Name="HomePage" Opacity="1">
                            <Grid.RenderTransform>
                                <TranslateTransform />
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,18,0,0">
                                <TextBlock Text="LE VOYAGE COMMENCE"
                                           Style="{StaticResource OverlineStyle}"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="Répondez à l’appel"
                                           Style="{StaticResource PageTitleStyle}" />
                                <TextBlock Text="Votre aventure est prête. Les archives, le moteur et les règles de lancement ont été contrôlés."
                                           Style="{StaticResource PageSubtitleStyle}"
                                           MaxWidth="560"
                                           HorizontalAlignment="Left"
                                           Margin="0,10,0,0" />
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,25,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Padding="17" Background="#A815161D" BorderBrush="#55645247" BorderThickness="1" CornerRadius="3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="43" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="31" Height="31" HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="16">
                                            <TextBlock Text="✦" Foreground="{DynamicResource AccentBrightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="CONFIGURATION" Foreground="#F0E4D3" FontWeight="Bold" FontSize="10" />
                                            <TextBlock Text="Affichage, son et accessibilité" Foreground="#948C83" FontSize="10" Margin="0,7,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" Padding="17" Background="#A815161D" BorderBrush="#55645247" BorderThickness="1" CornerRadius="3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="43" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="31" Height="31" HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="16">
                                            <TextBlock Text="⚔" Foreground="{DynamicResource AccentBrightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="MULTIJOUEUR" Foreground="#F0E4D3" FontWeight="Bold" FontSize="10" />
                                            <TextBlock x:Name="MultiplayerCardText" Foreground="#948C83" FontSize="10" Margin="0,7,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border Grid.Row="2" Margin="0,22,0,0" Padding="15,12" Background="#7714161C" BorderBrush="#3EFFFFFF" BorderThickness="1,0,1,0">
                                <Grid>
                                    <TextBlock Text="SESSION ACTIVE" Foreground="#837B73" FontSize="9" FontWeight="Bold" />
                                    <TextBlock x:Name="LaunchSummaryText" HorizontalAlignment="Right" Foreground="#DDD2C4" FontSize="11" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="4" Margin="0,26,0,4">
                                <Button x:Name="PlayButton"
                                        Width="286"
                                        HorizontalAlignment="Left"
                                        Content="ENTRER DANS L’AVENTURE"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="OnPlayClick" />
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button x:Name="NewsButton"
                                            Content="ACTUALITÉS"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,0,9,0"
                                            Visibility="Collapsed"
                                            Click="OnNewsClick" />
                                    <Button x:Name="SupportButton"
                                            Content="AIDE &amp; SUPPORT"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Visibility="Collapsed"
                                            Click="OnSupportClick" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="SettingsPage" Visibility="Collapsed" Opacity="0">
                            <Grid.RenderTransform>
                                <TranslateTransform X="24" />
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,18,0,16">
                                <TextBlock Text="LE MONDE SELON VOS RÈGLES" Style="{StaticResource OverlineStyle}" Margin="0,0,0,8" />
                                <TextBlock Text="Configuration" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock Text="Ces préférences sont propres à ce jeu et seront appliquées dès le prochain lancement."
                                           Style="{StaticResource PageSubtitleStyle}"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar">
                                        <Setter Property="Width" Value="8" />
                                        <Setter Property="Margin" Value="7,0,0,0" />
                                        <Setter Property="Background" Value="#351D1D22" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ScrollBar">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                        <primitives:Track x:Name="PART_Track" IsDirectionReversed="True">
                                                            <primitives:Track.DecreaseRepeatButton>
                                                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
                                                            </primitives:Track.DecreaseRepeatButton>
                                                            <primitives:Track.Thumb>
                                                                <Thumb MinHeight="30">
                                                                    <Thumb.Template>
                                                                        <ControlTemplate TargetType="Thumb">
                                                                            <Border Margin="1"
                                                                                    Background="#A67F6048"
                                                                                    BorderBrush="{DynamicResource AccentBrush}"
                                                                                    BorderThickness="1"
                                                                                    CornerRadius="3" />
                                                                        </ControlTemplate>
                                                                    </Thumb.Template>
                                                                </Thumb>
                                                            </primitives:Track.Thumb>
                                                            <primitives:Track.IncreaseRepeatButton>
                                                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
                                                            </primitives:Track.IncreaseRepeatButton>
                                                        </primitives:Track>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ScrollViewer.Resources>
                                <Grid Margin="0,3,12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="185" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="46" />
                                        <RowDefinition Height="46" />
                                        <RowDefinition Height="46" />
                                        <RowDefinition Height="40" />
                                        <RowDefinition Height="40" />
                                        <RowDefinition Height="40" />
                                        <RowDefinition Height="40" />
                                        <RowDefinition Height="44" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Résolution" Style="{StaticResource SettingLabelStyle}" />
                                    <ComboBox x:Name="ResolutionSelector" Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldComboStyle}" SelectionChanged="OnSettingsChanged" />
                                    <TextBlock Grid.Row="1" Text="Mode d’affichage" Style="{StaticResource SettingLabelStyle}" />
                                    <ComboBox x:Name="WindowModeSelector" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldComboStyle}" SelectionChanged="OnSettingsChanged" />
                                    <TextBlock Grid.Row="2" Text="Qualité graphique" Style="{StaticResource SettingLabelStyle}" />
                                    <ComboBox x:Name="QualitySelector" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldComboStyle}" SelectionChanged="OnSettingsChanged" />
                                    <TextBlock Grid.Row="3" Text="Fluidité" Style="{StaticResource SettingLabelStyle}" />
                                    <CheckBox x:Name="VSyncCheck" Grid.Row="3" Grid.Column="1" Content="Synchronisation verticale" Style="{StaticResource RpgCheckStyle}" Checked="OnSettingsChanged" Unchecked="OnSettingsChanged" />

                                    <TextBlock Grid.Row="4" Text="Volume général" Style="{StaticResource SettingLabelStyle}" />
                                    <Grid Grid.Row="4" Grid.Column="1">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                                        <Slider x:Name="MasterVolumeSlider" Style="{StaticResource RpgSliderStyle}" ValueChanged="OnVolumeChanged" />
                                        <TextBlock x:Name="MasterVolumeValue" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#C7BBAE" FontSize="10" />
                                    </Grid>
                                    <TextBlock Grid.Row="5" Text="Musique" Style="{StaticResource SettingLabelStyle}" />
                                    <Grid Grid.Row="5" Grid.Column="1">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                                        <Slider x:Name="MusicVolumeSlider" Style="{StaticResource RpgSliderStyle}" ValueChanged="OnVolumeChanged" />
                                        <TextBlock x:Name="MusicVolumeValue" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#C7BBAE" FontSize="10" />
                                    </Grid>
                                    <TextBlock Grid.Row="6" Text="Effets" Style="{StaticResource SettingLabelStyle}" />
                                    <Grid Grid.Row="6" Grid.Column="1">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                                        <Slider x:Name="EffectsVolumeSlider" Style="{StaticResource RpgSliderStyle}" ValueChanged="OnVolumeChanged" />
                                        <TextBlock x:Name="EffectsVolumeValue" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#C7BBAE" FontSize="10" />
                                    </Grid>
                                    <TextBlock Grid.Row="7" Text="Accessibilité" Style="{StaticResource SettingLabelStyle}" />
                                    <CheckBox x:Name="ReduceMotionCheck"
                                              Grid.Row="7"
                                              Grid.Column="1"
                                              Content="Réduire les mouvements et transitions"
                                              Style="{StaticResource RpgCheckStyle}"
                                              Checked="OnReduceMotionChanged"
                                              Unchecked="OnReduceMotionChanged" />
                                </Grid>
                            </ScrollViewer>
                            <Button Grid.Row="2"
                                    Width="178"
                                    Height="42"
                                    Margin="0,14,0,4"
                                    HorizontalAlignment="Left"
                                    Content="ENREGISTRER"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OnSaveClick" />
                        </Grid>

                        <Grid x:Name="MultiplayerPage" Visibility="Collapsed" Opacity="0">
                            <Grid.RenderTransform>
                                <TranslateTransform X="24" />
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,18,0,18">
                                <TextBlock Text="FORGEZ VOTRE COMPAGNIE" Style="{StaticResource OverlineStyle}" Margin="0,0,0,8" />
                                <TextBlock Text="Multijoueur" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock Text="Choisissez votre mode de session. L’hôte local conserve l’autorité sur toutes les décisions de jeu."
                                           Style="{StaticResource PageSubtitleStyle}"
                                           Margin="0,8,0,0" />
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="SoloMode"
                                             Grid.Column="0"
                                             GroupName="SessionMode"
                                             Style="{StaticResource ModeCardStyle}"
                                             Checked="OnSessionModeChanged">
                                    <StackPanel>
                                        <TextBlock Text="SOLO" Foreground="#F0E6D8" FontWeight="Bold" FontSize="10" />
                                        <TextBlock Text="Aventure privée" Foreground="#948C83" FontSize="9" Margin="0,7,0,0" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="LocalHostMode"
                                             Grid.Column="1"
                                             GroupName="SessionMode"
                                             Style="{StaticResource ModeCardStyle}"
                                             Checked="OnSessionModeChanged">
                                    <StackPanel>
                                        <TextBlock Text="HÔTE LOCAL" Foreground="#F0E6D8" FontWeight="Bold" FontSize="10" />
                                        <TextBlock Text="Session autoritaire" Foreground="#948C83" FontSize="9" Margin="0,7,0,0" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="DirectConnectMode"
                                             Grid.Column="2"
                                             Margin="0"
                                             GroupName="SessionMode"
                                             Style="{StaticResource ModeCardStyle}"
                                             Checked="OnSessionModeChanged">
                                    <StackPanel>
                                        <TextBlock Text="REJOINDRE" Foreground="#F0E6D8" FontWeight="Bold" FontSize="10" />
                                        <TextBlock Text="Transport à venir" Foreground="#948C83" FontSize="9" Margin="0,7,0,0" />
                                    </StackPanel>
                                </RadioButton>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="185" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="52" />
                                    <RowDefinition Height="52" />
                                    <RowDefinition Height="52" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Nom du joueur" Style="{StaticResource SettingLabelStyle}" />
                                <TextBox x:Name="PlayerNameText" Grid.Row="0" Grid.Column="1" Height="40" Style="{StaticResource FieldTextStyle}" TextChanged="OnSettingsChanged" />
                                <TextBlock Grid.Row="1" Text="Adresse du serveur" Style="{StaticResource SettingLabelStyle}" />
                                <TextBox x:Name="ServerAddressText" Grid.Row="1" Grid.Column="1" Height="40" Style="{StaticResource FieldTextStyle}" TextChanged="OnSettingsChanged" />
                                <TextBlock Grid.Row="2" Text="Port" Style="{StaticResource SettingLabelStyle}" />
                                <Grid Grid.Row="2" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="38" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ServerPortText"
                                             Height="40"
                                             Style="{StaticResource FieldTextStyle}"
                                             PreviewTextInput="OnPortPreviewTextInput"
                                             TextChanged="OnSettingsChanged" />
                                    <Button Grid.Column="1" Content="−" Margin="5,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="OnPortDownClick" />
                                    <Button Grid.Column="2" Content="+" Margin="5,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="OnPortUpClick" />
                                </Grid>
                            </Grid>

                            <Border Grid.Row="3" Margin="0,19,0,4" Padding="14,11" VerticalAlignment="Top" Background="#7917161A" BorderBrush="#65604D42" BorderThickness="1" CornerRadius="3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◇" Foreground="{DynamicResource AccentBrightBrush}" FontSize="16" Margin="0,0,10,0" />
                                    <TextBlock x:Name="MultiplayerNoticeText" MaxWidth="520" Foreground="#B9A999" FontSize="10" TextWrapping="Wrap" LineHeight="16" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusLight" Width="6" Height="6" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" />
                            <TextBlock x:Name="StatusText" Text="Prêt."
                                       Foreground="#AAB9A7"
                                       FontSize="10"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Width="92"
                                Height="34"
                                Content="QUITTER"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OnQuitClick" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Grid Height="48" VerticalAlignment="Top" Background="#7805070C" MouseLeftButtonDown="OnTitleBarMouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <Path Width="12" Height="14" Stretch="Fill" Data="M 6 0 L 12 5 L 9.5 14 L 6 11.5 L 2.5 14 L 0 5 Z" Fill="{DynamicResource AccentBrush}" />
                <TextBlock Text="OPENRPG FORGE"
                           Margin="10,0,0,0"
                           Foreground="#BEB5AA"
                           FontSize="10"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="—" Style="{StaticResource ChromeButtonStyle}" Click="OnMinimizeClick" />
                <Button x:Name="MaximizeButton" Content="□" Style="{StaticResource ChromeButtonStyle}" Click="OnMaximizeClick" />
                <Button Content="×" Style="{StaticResource ChromeButtonStyle}" Click="OnQuitClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
