<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Forge.GameLauncher</RootNamespace>
    <AssemblyName>OpenRPG_Forge_GameLauncher</AssemblyName>
    <ApplicationIcon>..\Forge.CreatorLauncher\openrpg_forge.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <FileVersion>0.1.0.0</FileVersion>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <Authors>OpenRPG Forge</Authors>
    <Company>OpenRPG Forge</Company>
    <Product>OpenRPG Forge Game Launcher</Product>
    <Description>Configurable launcher for games created with OpenRPG Forge.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Forge.ModuleFormat\Forge.ModuleFormat.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\launcher-dark-citadel-v1.png" />
    <Resource Include="Assets\launcher-dark-citadel-v1.png" />
  </ItemGroup>
</Project>
