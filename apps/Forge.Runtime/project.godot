; Engine configuration file.
; Edit through the Godot editor when possible.

config_version=5

[application]

config/name="OpenRPG Forge — Crypte des Cendres"
run/main_scene="res://Main.tscn"
boot_splash/bg_color=Color(0.043, 0.035, 0.071, 1)
boot_splash/image="res://branding/openrpg_forge_splash.png"
boot_splash/minimum_display_time=700
boot_splash/show_image=true
boot_splash/stretch_mode=1
run/max_fps=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=1

[dotnet]

project/assembly_name="Forge.Runtime"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[shader_globals]

gnd_wind_direction={
"type": "vec2",
"value": Vector2(0.8, 0.3)
}
gnd_wind_speed={
"type": "float",
"value": 1.0
}
gnd_wind_strength={
"type": "float",
"value": 1.25
}
