{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenRPG Forge Studio",
  "version": "0.1.0",
  "identifier": "org.openrpg.forge.studio",
  "build": {
    "beforeDevCommand": {
      "script": "pwsh -NoProfile -File ../../scripts/Invoke-StudioTrunk.ps1 -Action serve",
      "cwd": "."
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "pwsh -NoProfile -File ../../scripts/Invoke-StudioTrunk.ps1 -Action build",
      "cwd": "."
    },
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenRPG Forge Studio",
        "width": 1600,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 600,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": false
  }
}
